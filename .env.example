# Supabase Dashboard > Project Settings > Database > Connection string > URI
# For the pooler, use the username format postgres.<project-ref>.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres
DATABASE_SSL=true
FRONTEND_ORIGIN=http://localhost:3000
PORT=3001
# Keep total connections within the PostgreSQL plan: PGPOOL_MAX * backend instances.
PGPOOL_MAX=5
# Per-process request caps per source IP per minute.
RATE_LIMIT_STUDENTS=500
RATE_LIMIT_RESULTS=500
# Number of trusted proxies in front of the backend, if configured.
TRUST_PROXY_HOPS=1
